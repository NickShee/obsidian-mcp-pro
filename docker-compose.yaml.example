# ============================================================
# obsidian-mcp-pro — 部署配置模板（推荐标准化版本）
#
# 这是模板文件，本身不参与运行。实际部署请复制成 docker-compose.yaml：
#     cp docker-compose.yaml.example docker-compose.yaml
#     cp .env.example .env          # 填 vault 路径 / token / embedding key
#     docker compose build
#     docker compose up -d
#
# docker-compose.yaml 已被 .gitignore 忽略（含环境相关、逐机不同的取值）。
# 镜像 tag 约定：nick-customized
# ============================================================

name: ob-mcp-pro-nick

services:
  ob-mcp-pro-nick:
    build: .
    image: ghcr.io/nickshee/obsidian-mcp-pro:nick-customized

    # 容器名被 nginx-proxy-manager 的上游直接引用（ob-main.xshome.cc 的转发目标），
    # 改名需同步改 NPM，否则该域名会 502。
    container_name: ob-mcp-pro-nick

    restart: unless-stopped
    networks:
      - lobehub_lobe-net

    ports:
      - "3336:3333"

    volumes:
      - ${VAULT_PATH_MAIN}:/vault

    # 容器变量在此显式列明 —— 刻意不使用 env_file：
    # 否则 .env 里所有值（含用不到的 token）都会被无差别注入容器。
    # .env 在本配置里只承担 compose 的 ${} 变量插值。
    environment:
      TZ: Asia/Shanghai
      OBSIDIAN_VAULT_PATH: /vault
      MCP_HTTP_TOKEN: ${MCP_HTTP_TOKEN_MAIN}
      LOG_LEVEL: info
      LOG_FORMAT: text
      OBSIDIAN_READ_PATHS: .

      # SSE keep-alive 心跳（stateful 模式防断联；stateless 下自动失效，无副作用）
      SSE_KEEPALIVE_ENABLED: "true"
      SSE_KEEPALIVE_INTERVAL_MS: "15000"

      # 传输模式（二选一）
      #   "false" = stateful + SSE 心跳：session 管理 + 长连接保活，兼容所有客户端
      #   "true"  = stateless：无 session/长连接，每次请求独立，彻底免疫反代断联（治本）
      # 修改后需重启容器生效；切换后需在 LobeHub 重新同步该 MCP
      STATELESS_MODE: "true"

      # 语义搜索（可选）。URL 与 KEY 放在 .env，不写进本文件
      OBSIDIAN_EMBEDDING_PROVIDER: openai
      OBSIDIAN_EMBEDDING_MODEL: qwen3.7-text-embedding
      OBSIDIAN_EMBEDDING_URL: ${OBSIDIAN_EMBEDDING_URL}
      OBSIDIAN_EMBEDDING_API_KEY: ${OBSIDIAN_EMBEDDING_API_KEY}

      # ── 默认 frontmatter：混合模式（默认启用）──
      # 模板打底 + env 覆盖：两个来源同时生效，env 里出现的键压过模板。
      # 模板必须是 vault 内的 .md 文件（会走 vault 边界与 OBSIDIAN_READ_PATHS 校验）。
      # 改模板即可改变新笔记的默认 fm，不需要重启容器。
      OBSIDIAN_FM_SOURCE: template
      OBSIDIAN_FRONTMATTER_TEMPLATE: 99.templates/tp-01-general.md

      # env 覆盖层：只写需要「压过模板」的字段。
      # 留成空对象 = 完全以模板为准；要临时钉住某个字段再往里加，例如 '{"status":"draft"}'。
      # 若只想用 env、完全不读模板：把 OBSIDIAN_FM_SOURCE 改成 env（或整行删掉）。
      OBSIDIAN_DEFAULT_FRONTMATTER: '{}'

      # 值里支持两种占位符：
      #   {{date:YYYY-MM-DD}} / {{time:HH:mm}}   （Obsidian 核心语法）
      #   <% tp.date.now("YYYY-MM-DD", 7) %>     （Templater 白名单：now / tomorrow / yesterday）
      # 白名单外的 Templater 表达式（如 tp.system.prompt）会告警并丢弃该字段。
      # 写入语义仍是「只补缺失」：已有 fm 只追加缺失键，原有键的值/顺序/注释逐字节不动。

      # 自动维护的字段：每次写入（新建/追加/前置/改 fm/区块编辑）都刷新为当天日期。
      # 唯一会「覆盖已有键」的口子；批量工具（move/delete/rename_tag）刻意不触发。
      OBSIDIAN_MODIFIED_FIELDS: modified

    command:
      - "--transport=http"
      - "--host=0.0.0.0"
      - "--port=3333"
      - "--rate-limit=600"

    # 日志驱动：
    #   db        = 群晖 Container Manager 内置驱动，日志入库，规避 json-file 的写放大；仅群晖可用
    #   json-file = 通用驱动；此时可启用下面两个 options 限制单文件体积
    logging:
      driver: db
      # options:
      #   max-size: "10m"
      #   max-file: "3"

networks:
  lobehub_lobe-net:
    external: true
