# ========== obsidian-mcp-pro-nick 环境变量模板（复制为 .env 后填写）==========
# 这份 .env 供 docker compose 做变量插值（${...}）使用。
# 容器实际拿到的变量都在 docker-compose.yaml 的 environment 里显式列出。

# 宿主机 Vault 目录（映射到容器 /vault）
VAULT_PATH_MAIN=/path/to/your/vault

# MCP HTTP 访问 token（需与 LobeHub 连接器配置一致）
MCP_HTTP_TOKEN_MAIN=your-token-here

# 语义搜索（可选，如启用 obsidian-mcp-pro semantic search）
OBSIDIAN_EMBEDDING_API_KEY=your-aliyun-bailian-api-key

# 新建笔记的默认 frontmatter（可选）
#   JSON 对象。作为最底层「只补缺失」，绝不覆盖已有键：
#     - 已有 frontmatter：只追加缺失键，原有键的值/顺序/注释/引号逐字节不动
#     - 无 frontmatter：补一个完整默认块
#     - create_note 额外写入服务端本地日期的 created；append/prepend 回填旧笔记时不写 created
#   填好后到 docker-compose.yaml 里取消对应那行的注释才会生效
# OBSIDIAN_DEFAULT_FRONTMATTER='{"tags":[],"status":"draft","aliases":[]}'
