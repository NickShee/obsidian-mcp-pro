# ========== obsidian-mcp-pro-nick 环境变量模板（复制为 .env 后填写）==========
# 这份 .env 供 docker compose 做变量插值（${...}）使用。
# 容器实际拿到的变量都在 docker-compose.yaml 的 environment 里显式列出。

# 宿主机 Vault 目录（映射到容器 /vault）
VAULT_PATH_MAIN=/path/to/your/vault

# MCP HTTP 访问 token（需与 LobeHub 连接器配置一致）
MCP_HTTP_TOKEN_MAIN=your-token-here

# 语义搜索（可选，如启用 obsidian-mcp-pro semantic search）
OBSIDIAN_EMBEDDING_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OBSIDIAN_EMBEDDING_API_KEY=your-aliyun-bailian-api-key

# 默认 frontmatter 的来源配置在 docker-compose.yaml 的 environment 里，不在这里：
#   OBSIDIAN_FM_SOURCE           env | template —— template 为混合模式（模板打底 + env 覆盖）
#   OBSIDIAN_FRONTMATTER_TEMPLATE  vault 内的模板路径，如 99.templates/tp-01-general.md
#   OBSIDIAN_DEFAULT_FRONTMATTER   env 覆盖层（JSON），只写需要压过模板的字段
#   OBSIDIAN_MODIFIED_FIELDS       每次写入刷新为当天日期的字段，如 modified
# 详见 docker-compose.yaml.example 里的注释。
# 本文件只负责 compose 的变量插值（vault 路径 / token / embedding key）。
